{
  "name": "sqlite-local-ai-memory",
  "version": "1.3.2",
  "description": "100% In-Process Bare-Metal Hybrid Memory Engine & MCP Server for LLMs (SQLite + Int8 Vectors).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sqlite-local-ai-memory": "./dist/mcp_server.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/mcp_server.js",
    "test": "node ./dist/stress_test.js",
    "test:mcp": "node ./dist/multi_env_mcp_test.js",
    "test:history": "node ./dist/test_autodream_history.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "sqlite",
    "memory",
    "rag",
    "vector-search",
    "llm",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.3.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
