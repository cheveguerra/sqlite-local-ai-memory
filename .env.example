# ==============================================================================
# sqlite-local-ai-memory Configuration Template (.env)
# ==============================================================================

# Database storage path (default: ./memoria.db)
SQLITE_MEM_PATH=./memoria.db

# Primary user identity for contextual memory
MEMORY_USER_NAME=User
MEMORY_USER_ID=user_default

# ------------------------------------------------------------------------------
# API Keys & Endpoints
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required if using gemini/... models or cloud embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama base URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# OpenRouter API Key (Optional, for openrouter/... models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key & Custom Base URL (Optional, for openai/... or vLLM/LMStudio)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Cognitive Roles Model Sizing (Universal PROVIDER/MODEL syntax)
#
# Supported Providers:
#   - gemini/...     -> Uses Google GenAI SDK (e.g. gemini/gemini-2.5-flash-lite)
#   - ollama/...     -> Uses local Ollama HTTP API (e.g. ollama/qwen2.5-coder:1.5b)
#   - openai/...     -> Uses OpenAI-compatible /v1/chat/completions (e.g. openai/gpt-4o-mini)
#   - openrouter/... -> Uses OpenRouter /v1/chat/completions (e.g. openrouter/anthropic/claude-3.5-haiku)
# ------------------------------------------------------------------------------

# 1. GATEKEEPER (The Bouncer): Drops conversational chit-chat before touching APIs
#    Recommended: Local Ollama mini SLM (1B-3B)
GATEKEEPER_MODEL=ollama/qwen2.5-coder:1.5b

# 2. QUERY_EXPANDER (The Librarian): Rewrites vague queries using conversational context.
#    OPTIONAL: Set to "none" or leave empty to disable!
#    - Disabled ("none" or empty): Instant literal search with 0 ms overhead, $0 cost, zero hallucinations.
#    - Enabled (e.g. gemini/...): Resolves anaphoric references ("where was that server?") into sharp keywords.
EXPANDER_MODEL=gemini/gemini-2.5-flash-lite

# 3. NOTARY (The Clerk): Extracts atomic facts in strict structured JSON
#    Recommended: Gemini Flash-Lite (or models with rock-solid Structured Output)
NOTARY_MODEL=gemini/gemini-2.5-flash-lite

# 4. SEMANTIC_ARBITER (The Auditor): Detects collisions and soft-deletes outdated facts
#    Recommended: Gemini Flash-Lite (requires relational logic)
ARBITER_MODEL=gemini/gemini-2.5-flash-lite

# 5. STATE_ORCHESTRATOR (The Historian / AutoDream): Multi-hour state synthesis and 4-block triage
#    Recommended: Gemini Flash-Lite (requires 4k-8k context + complex nested JSON schema)
ORCHESTRATOR_MODEL=gemini/gemini-2.5-flash-lite

# 6. EMBEDDER (The Vectorizer): Generates 768-dim dense vectors for Int8 SQLite quantization
#    Recommended: Local Ollama nomic-embed-text (fallback: gemini-embedding-001)
EMBEDDER_MODEL=ollama/nomic-embed-text
