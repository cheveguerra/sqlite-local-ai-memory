# ============================================================================
# sqlite-local-ai-memory Configuration Example
# Copy this file to .env and adjust to your environment
# ============================================================================

# 1. Database Persistence & Performance
# When using the MCP Server (sqlite-local-ai-memory), SQLITE_MEM_PATH defaults
# automatically to ~/.local-ai-memory/memoria.db if omitted.
# Note: Do not mix different EMBEDDER_MODEL providers on the same .db file.
SQLITE_MEM_PATH=./memoria.db

# Optional: Set to WAL for maximum speed on local NVMe/SSD drives (enables 256MB mmap).
# Defaults to TRUNCATE (safe for Docker bind mounts, NFS, SMB, and Proxmox).
# SQLITE_JOURNAL_MODE=WAL

# 2. Providers & Endpoints
# Out-of-the-Box Cloud Mode: Only GEMINI_API_KEY is required!
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Mode:
# Leave blank to run 100% offline without local LLM (instant fallback, zero network timeouts).
# To enable local Ollama, uncomment and set your URL:
# OLLAMA_URL=http://localhost:11434
OLLAMA_URL=

# 3. Cognitive Agents Matrix (Role Assignment)
# Format: <provider>/<model_name>  (Supported providers: gemini, ollama)
# Note: Only "EXPANDER_MODEL" (Query Expander) can be set to "none" to skip LLM query expansion (<15ms MCP search).
# Essential roles (GATEKEEPER, NOTARY, ARBITER, ORCHESTRATOR, EMBEDDER) cannot be disabled.

# --- Option A: Default Cloud Out-of-the-Box (Google Gemini) ---
# 1. Gatekeeper (Fast binary noise filter: 0 = noise, 1 = useful)
GATEKEEPER_MODEL=gemini/gemini-2.5-flash-lite

# 2. Query Expander / Librarian (Expands search queries into FTS5 + semantic variants; optional: "none")
EXPANDER_MODEL=gemini/gemini-2.5-flash-lite

# 3. Notary (Extracts categorized atomic facts from dialogue)
NOTARY_MODEL=gemini/gemini-2.5-flash-lite

# 4. Semantic Arbiter (Detects contradictions and obsolete facts: SUPERSEDE | KEEP_BOTH | IGNORE)
ARBITER_MODEL=gemini/gemini-2.5-flash-lite

# 5. State Orchestrator (Consolidates active state Dashboard JSON + AutoDream self-healing)
ORCHESTRATOR_MODEL=gemini/gemini-2.5-flash-lite

# 6. Vector Embedder (768-dim embeddings)
EMBEDDER_MODEL=gemini/gemini-embedding-001

# ============================================================================
# Option B: 100% Local & Offline (Ollama — Zero API Keys)
# ============================================================================
# GATEKEEPER_MODEL=ollama/gemma4:e2b
# EXPANDER_MODEL=none
# NOTARY_MODEL=ollama/qwen2.5:3b
# ARBITER_MODEL=ollama/qwen2.5:3b
# ORCHESTRATOR_MODEL=ollama/qwen2.5:3b
# EMBEDDER_MODEL=ollama/nomic-embed-text
